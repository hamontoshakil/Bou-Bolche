<?xml version='1.0' encoding='utf-8'?>
<widget id="com.boubolche.app" version="1.1.0" android-versionCode="__VERSION_CODE__" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Bou Bolche</name>
    <description>Family Bazar Tracker</description>
    <author email="hamontoshakil@gmail.com" href="https://github.com/hamontoshakil/Bou-Bolche">Hamonto Shakil</author>
    <content src="index.html" />
    <allow-navigation href="*" />
    <allow-intent href="*" />
    <access origin="*" />
    <preference name="BackgroundColor" value="0xffF8FAFC" />
    <preference name="Scheme" value="https" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        </config-file>
    </platform>
</widget>
